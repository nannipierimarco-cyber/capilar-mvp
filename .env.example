# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_SECRET=<your-admin-secret>

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Flow (payments) ──────────────────────────────────────────────────────────
FLOW_API_KEY=<flow-api-key>
FLOW_SECRET_KEY=<flow-secret-key>
FLOW_BASE_URL=https://www.flow.cl/api

# ─── WhatsApp Cloud API (Meta) — required for Skin Copilot production ─────────
# Get these from: https://developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=<permanent-system-user-token>
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
# Choose any secret string; must match what you register in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=<your-verify-token>

# ─── Calendly (Phase 2) ───────────────────────────────────────────────────────
# CALENDLY_API_TOKEN=
# CALENDLY_WEBHOOK_SIGNING_KEY=
