# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_SECRET=<your-admin-secret>

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_BASE_URL=https://nilolabs.vercel.app

# ─── Flow (payments) ──────────────────────────────────────────────────────────
FLOW_API_KEY=<flow-api-key>
FLOW_SECRET_KEY=<flow-secret-key>
FLOW_BASE_URL=https://www.flow.cl/api

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Get these from: https://developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=<permanent-system-user-token>
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
# Must match the Verify Token you enter in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=<your-verify-token>
# Graph API version — update when Meta releases a new stable version
WHATSAPP_API_VERSION=v23.0

# ─── Skin Copilot test guard ──────────────────────────────────────────────────
# Comma-separated list of WhatsApp numbers allowed to use the bot during testing.
# If set, all other numbers are silently ignored.
# Remove or leave empty to allow all numbers (production mode).
SKIN_COPILOT_ALLOWED_TEST_PHONES=+56912345678,+56987654321

# ─── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token — scopes: crm.objects.contacts.read + write
HUBSPOT_ACCESS_TOKEN=pat-na1-...
# Secret shared between internal services calling /api/hubspot/sync-lead
INTERNAL_API_SECRET=<random-32-char-string>

# ─── Calendly ─────────────────────────────────────────────────────────────────
# Personal Access Token — Calendly → Integrations → API & Webhooks → Personal Access Tokens
# Required to fetch event start_time, cancel_url and reschedule_url from the Calendly API
# after the embed fires calendly.event_scheduled.
# Without this, HubSpot sync still works but appointment_datetime is omitted.
CALENDLY_TOKEN=<personal-access-token-from-calendly>
# Signing key shown when creating a webhook (requires paid Calendly plan)
# CALENDLY_WEBHOOK_SIGNING_KEY=<signing-key-from-calendly-dashboard>
# Public booking link when no doctor is assigned yet (optional fallback)
# NEXT_PUBLIC_DEFAULT_CALENDLY_URL=https://calendly.com/your-team/consulta
# Prefer a specific doctor for auto-assignment after quiz (optional)
# DEFAULT_DOCTOR_ID=<doctor_profiles.uuid>

# ─── App public URL (used for absolute URLs in emails) ────────────────────────
PUBLIC_BASE_URL=https://nilolabs.vercel.app

# ─── Meta Pixel (optional) ─────────────────────────────────────────────────────
# If set, loads the Meta Pixel base snippet + fires PageView/Lead events.
# Get it from Meta Events Manager → your Pixel → Settings.
NEXT_PUBLIC_META_PIXEL_ID=<meta-pixel-id>
